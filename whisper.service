# whisper systemd user service
#
# Installation:
#   1. Copy this file to ~/.config/systemd/user/whisper.service
#   2. Edit the ExecStart path to match your installation
#   3. Enable and start:
#      systemctl --user daemon-reload
#      systemctl --user enable whisper
#      systemctl --user start whisper
#
# View logs:
#   journalctl --user -u whisper -f

[Unit]
Description=Whisper - Voice Keyboard
Documentation=https://github.com/mikesmullin/whisper
# After= (not just Wants=) matters: on a joint restart whisper otherwise
# races ahead of the server and spams "Server socket not found" at the
# polling interval until the socket appears.
After=perception-voice.service graphical-session.target
Wants=perception-voice.service

[Service]
Type=simple
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash -lc '%h/.local/bin/whisper'
Restart=on-failure
RestartSec=5
TimeoutStopSec=10s

[Install]
WantedBy=default.target
